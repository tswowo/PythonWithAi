# ---------- 虚拟环境（uv 管理，可由 pyproject.toml + uv.lock 重建）----------
/.venv/
venv/
env/

# ---------- 密钥与本地配置（绝不入库）----------
.env
.env.*
!.env.example

# ---------- IDE ----------
/.idea/
.vscode/

# ---------- Python 编译与缓存产物 ----------
__pycache__/
*.py[cod]

# ---------- 打包与分发产物 ----------
build/
dist/
*.egg-info/

# ---------- 测试与静态检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.bak
*.swp

# ---------- 操作系统生成的文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# 注意：uv.lock 和 .python-version 应当提交（分别锁定依赖版本与解释器版本），不要加进忽略列表